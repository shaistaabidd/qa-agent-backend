# Copy to .env for local development (dotenv loads it in development and test).
# Secrets in production come from the platform's environment variables, never from a committed file.

# --- App ---
APP_NAME="QA Agent"
APP_HOST=localhost:3000
PORT=3000
RAILS_MAX_THREADS=5
WEB_CONCURRENCY=0
RAILS_LOG_LEVEL=info
# Production only: comma-separated hostnames this API answers to.
ALLOWED_HOSTS=

# --- Frontend ---
# Links in emails (invitations) point here.
FRONTEND_URL=http://localhost:5173
# Comma-separated origins allowed to call /graphql from a browser.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Database (production uses DATABASE_URL) ---
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=
DATABASE_URL=

# --- Redis 7+ (Sidekiq jobs, cache, rate limits) ---
REDIS_URL=redis://localhost:6379/0
# Heroku Redis only: its TLS certificate is self-signed.
REDIS_SSL_VERIFY_NONE=
SIDEKIQ_CONCURRENCY=5

# --- Feature flags (Flipper, backed by Redis above) ---
# Leave both unset in development; production requires both (they protect the /flipper dashboard).
FLIPPER_UI_USERNAME=
FLIPPER_UI_PASSWORD=

# --- GraphQL ---
# Introspection is on in development/test and off elsewhere unless set to true.
GRAPHQL_INTROSPECTION=

# --- Mail ---
MAILER_SENDER=no-reply@example.com
SMTP_ADDRESS=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# --- SMS (Twilio) ---
# Development: Twilio's TEST Account SID and Auth Token with TWILIO_FROM_NUMBER=+15005550006
# (real API answers, nothing sent or charged). Production requires the SID, the token, and a
# From number or a Messaging Service SID (set, it is used instead of the From number).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=

# --- Sign in with Google (optional) ---
# A Google OAuth client of type "Web application". Add GOOGLE_REDIRECT_URI to its
# authorized redirect URIs; it defaults to http://localhost:$PORT/auth/google/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
# true: also ask for phone and birthday through the People API (sensitive scopes that
# need Google's app verification). Leave empty for name, email and photo only.
GOOGLE_PEOPLE_DETAILS=

# --- Storage (production): least-privilege IAM user for one private bucket ---
AWS_REGION=us-east-1
S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Error tracking ---
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0

# --- Seeds: first super admin ---
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
